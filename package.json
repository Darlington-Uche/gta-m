{
  "name": "gta-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GTA Marketplace API \u2014 Express + Postgres/Firestore + Solana (Metaplex Core); runs on Node or as a Supabase Edge Function",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:devnet": "NETWORK=devnet node --watch src/server.js",
    "start:mainnet": "NETWORK=mainnet-beta node src/server.js",
    "test": "node --test test/e2e.test.js test/solana-tx.test.js",
    "wallets": "node scripts/generate-wallets.js",
    "check": "node scripts/check-config.js",
    "collection:create": "node scripts/create-collection.js",
    "seed": "node scripts/seed-items.js",
    "docs": "node scripts/gen-api-docs.js",
    "collection:add": "node scripts/add-collection.js",
    "demo": "node scripts/demo.js",
    "test:pg": "DB_DRIVER=pglite CHAIN_DRIVER=mock node --test test/e2e.test.js test/solana-tx.test.js",
    "build:edge": "node supabase/build.mjs"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/mpl-toolbox": "^0.11.5",
    "@metaplex-foundation/umi": "^1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.6.0",
    "@metaplex-foundation/umi-uploader-irys": "^1.6.0",
    "bs58": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "esbuild": "^0.25.0"
  }
}
