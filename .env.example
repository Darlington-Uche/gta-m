# ========= THE SWITCH =========
# devnet  = test everything with free SOL.   mainnet-beta = real money (also needs MAINNET_CONFIRM below)
NETWORK=devnet
# MAINNET_CONFIRM=I_UNDERSTAND

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080          # this API's public URL (stored inside every NFT's metadata uri)
ASSETS_BASE_URL=https://your-frontend.example   # where /assets/art/a1.png ... are hosted (NFT images)
CORS_ORIGINS=http://localhost:5500,https://your-frontend.example

# ========= Firebase (firebase-admin) =========
# base64 of the service-account JSON:  base64 -w0 serviceAccount.json   (works great as a Railway variable)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com   # set to store uploads in Firebase Storage (else local ./uploads)

# ========= Wallets (use DIFFERENT keys per network; `npm run wallets` makes them) =========
VAULT_SECRET_KEY_DEVNET=
VAULT_SECRET_KEY_MAINNET=
# optional: separate collection-authority key (defaults to the vault key)
# COLLECTION_AUTHORITY_SECRET_KEY_MAINNET=
# Collections are NOT env vars: deploy one Core collection per era (updateAuthority = the vault address) and register it:
#   npm run collection:add -- --id vice --address <address>

# ========= RPC =========
# Public RPCs are rate limited. Use Helius/QuickNode in production.
RPC_URL_DEVNET=https://api.devnet.solana.com
RPC_URL_MAINNET=
# DAS_ENABLED_MAINNET=true     # true if your RPC supports the Digital Asset Standard (Helius does) -> faster ownership sync

# ========= Auth =========
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_WALLETS=YourAdminWalletPublicKey1,YourAdminWalletPublicKey2

# ========= Misc =========
# FIXED_SOL_USD=150          # handy on devnet: skip the price feed
RUN_JOBS=true                # background worker (payouts, refunds, expiry). Keep ONE instance running it.
# CRON_SECRET=               # enables POST /jobs/run for an external scheduler

# ========= Permanent NFT storage (Arweave via Irys) =========
# irys = (default on the real chain) when someone mints, the image + metadata are uploaded to Arweave; the MINTER pays the storage fee
#        inside the same wallet approval (the vault fronts it). none = metadata served by this API, images stay on ASSETS_BASE_URL.
# PERMASTORE=irys
# PERMASTORE_MAX_LAMPORTS=20000000   # refuse (and fall back to hosted metadata) if one upload would cost more than this
